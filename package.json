{
  "name": "obs3dplanetstartingpage",
  "version": "0.1.0-p3.1",
  "private": true,
  "description": "OBS 3D planet starting/BRB/thanks scenes - contributor tooling (P0 production foundation, build preview only)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "baseline:verify": "node scripts/baseline.mjs",
    "assets:check": "node scripts/assets.mjs",
    "release:check": "node scripts/check.mjs && node scripts/assets.mjs --release",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/site.mjs build",
    "site:verify": "node scripts/site.mjs verify",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "cloudflare:verify": "node scripts/cloudflare.mjs verify",
    "history:snapshot": "node scripts/history.mjs snapshot",
    "history:verify": "node scripts/history.mjs verify",
    "history:restore": "node scripts/history.mjs restore",
    "prepare:cloudflare": "node scripts/history.mjs prepare",
    "cloudflare:check-live": "node scripts/cloudflare-live.mjs",
    "site:select": "node scripts/site.mjs select",
    "package": "node scripts/package.mjs",
    "clean": "node -e \"Promise.all([import('node:fs').then(function (fs) { return Promise.all([fs.promises.rm('dist', { recursive: true, force: true }), fs.promises.rm('release', { recursive: true, force: true })]); })]).catch(function (e) { console.error(e); process.exit(1); })\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "wrangler": "4.158.0"
  }
}
